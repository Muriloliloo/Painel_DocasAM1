PORT=8787
NODE_ENV=development
PANEL_ALLOWED_ORIGIN=http://localhost:8000
GATEWAY_MODE=mock
# Manter unconfigured ate a TI implementar e aprovar o provider corporativo.
AUTH_MODE=unconfigured
# Em producao, somente depois da entrega da TI: AUTH_MODE=corporate
MOCK_SCENARIO=normal
DISPATCH_BASE_URL=https://envios.adminml.com
CUSTOMS_BASE_URL=https://envios.adminml.com
